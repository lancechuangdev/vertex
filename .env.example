ETHEREUM_RPC_URL=https://ethereum-rpc.example
BASE_RPC_URL=https://base-rpc.example
# For a new local database, choose recent blocks unless a genesis sync is
# intentional. Once persisted, the per-chain checkpoint takes precedence.
ETHEREUM_START_BLOCK=0
BASE_START_BLOCK=0
ETHEREUM_POLL_INTERVAL=5s
BASE_POLL_INTERVAL=1s
ETHEREUM_RPC_RATE_LIMIT=2
BASE_RPC_RATE_LIMIT=2
BLOCK_BATCH_SIZE=5
CONFIRMATION_DEPTH=12
RPC_CONCURRENCY=2
MAX_RETRIES=6
RETRY_INITIAL_DELAY=5s
