aws_region  = "us-west-2"
environment = "production"
image_tag   = "replace-with-a-git-sha"

# Create each RPC secret before applying. Store only the raw HTTPS RPC URL as
# its value, then place its ARN here.
chains = {
  ethereum = {
    chain_id           = 1
    rpc_secret_arn     = "arn:aws:secretsmanager:us-west-2:123456789012:secret:vertex/ethereum-rpc-AbCdEf"
    start_block        = 0
    confirmation_depth = 12
  }
  base = {
    chain_id           = 8453
    rpc_secret_arn     = "arn:aws:secretsmanager:us-west-2:123456789012:secret:vertex/base-rpc-AbCdEf"
    start_block        = 0
    confirmation_depth = 12
  }
}

# alarm_sns_topic_arn = "arn:aws:sns:us-west-2:123456789012:operations"
